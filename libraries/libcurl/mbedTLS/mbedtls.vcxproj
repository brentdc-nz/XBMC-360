      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
      <WarningLevel>Level3</WarningLevel>
      <DisableSpecificWarnings>4996;4244;4267;4018;4101;4146;%(DisableSpecificWarnings)</DisableSpecificWarnings>
